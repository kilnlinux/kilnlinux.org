// docs.kilnlinux.org: static Starlight build, assets only.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kilnlinux-docs",
  "compatibility_date": "2026-10-31",
  // wrangler deploy runs this first, so a deploy never ships a missing or stale dist/.
  "build": { "command": "npm run build" },
  "routes": [{ "pattern": "docs.kilnlinux.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Builds runs `wrangler preview` for non-main branches; it needs this block, even empty.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
