---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CodeBlock from '../components/CodeBlock.astro';

// The Arch-based Kiln Linux release; update these with each release.
const distro = 'https://github.com/kilnlinux/Kiln-Linux';
const version = 'v0.1.0';
const iso = 'kilnlinux-2026.11.04-x86_64.iso';
const sha256 = 'c243d60080da5fd12509145b7666ff874d678bf38094d3fed95bc8ad8693658a';
const isoUrl = `${distro}/releases/download/${version}/${iso}`;
const releaseUrl = `${distro}/releases/tag/${version}`;
const installDoc = `${distro}/blob/${version}/docs/install.md`;

const steps = [
  {
    title: 'Check the download',
    where: 'Your computer',
    lines: [
      { in: `sha256sum ${iso}` },
      { out: `# must print ${sha256}` },
    ],
  },
  {
    title: 'Write it to a USB stick',
    where: 'Your computer',
    lines: [
      { in: 'lsblk' },
      { out: '# find the stick; everything on it is erased' },
      { in: `sudo dd if=${iso} of=/dev/sdX bs=4M conv=fsync oflag=direct status=progress` },
    ],
  },
  {
    title: 'Boot it and install',
    where: 'Live system',
    lines: [
      { in: 'iwctl' },
      { out: '# Wi-Fi only; Ethernet is automatic' },
      { in: 'kiln-install' },
    ],
  },
];
---
<Base title="Download" description={`Download Kiln Linux ${version} (beta): an x86_64 live ISO with a text installer.`}>
  <PageHeader title="Download" />

  <div class="wrap">
    <div class="rounded-sm border border-rule-2 border-l-4 border-l-accent bg-well px-6 py-6 sm:px-8">
      <p class="font-mono text-xs uppercase tracking-wider text-accent">Beta · {version}</p>
      <p class="mt-2 text-2xl text-heading">Kiln Linux {version}, x86_64 live ISO</p>
      <p class="mt-3 max-w-[46rem]">
        An Arch Linux–based live ISO with <code>kiln-install</code>, a text installer. This is a beta: test it in a
        virtual machine or on a spare disk first.
      </p>
      <p class="mt-6">
        <a href={isoUrl} class="link font-mono">{iso}</a>
        <span class="text-mute" aria-hidden="true"> · </span>
        <a href={releaseUrl} class="link">Release notes</a>
      </p>
      <p class="mt-2 break-all font-mono text-xs text-mute">SHA-256 {sha256}</p>
      <div class="mt-6 grid gap-6 text-sm sm:grid-cols-2">
        <div>
          <h2 class="label">Tested</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <li>Unattended install in QEMU (UEFI, systemd-boot)</li>
            <li>Boot to the twmx desktop on tty1 login</li>
            <li>The <code>kiln</code> package profiles and daily <code>kiln-update</code> timer</li>
          </ul>
        </div>
        <div>
          <h2 class="label">Not tested yet</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <li>The other desktops: i3, Sway, Hyprland, XFCE, KDE Plasma, GNOME</li>
            <li>Legacy BIOS boot, GRUB and Limine</li>
            <li>Real hardware</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <Section title="Install it" id="install" lead="You need an x86_64 computer or VM with UEFI or BIOS, a disk to erase, and an internet connection during install: packages come from Arch’s mirrors.">
    <ol class="max-w-[52rem] space-y-8">
      {steps.map((s, i) => (
        <li class="grid gap-3 sm:grid-cols-[2.5rem_1fr]">
          <span class="font-mono text-2xl text-accent" aria-hidden="true">{i + 1}</span>
          <div class="min-w-0">
            <h3 class="text-lg">{s.title}</h3>
            <CodeBlock class="mt-2" caption={s.where} lines={s.lines} />
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-8 max-w-[46rem] text-sm">
      Pick the items in the installer’s menu in any order, then Install; it asks you to type the disk name before
      erasing it. The <a href={installDoc} class="link">install guide</a> covers every menu item, QEMU and building
      the ISO yourself.
    </p>
  </Section>
</Base>
