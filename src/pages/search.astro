---
import { DOCS } from '../data/site';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { archPackage, profiles } from '../data/kiln';
---
<Base title="Profiles" canonical="https://search.kilnlinux.org/search" description="The package profiles Kiln Linux ships, and the Arch packages each one installs.">
  <PageHeader
    title="Profiles"
    lede="Kiln installs packages from the official Arch Linux repositories. A profile is a named list of them; kiln applies it with pacman."
  />

  <Section title="Usage">
    <CodeBlock
      class="max-w-[46rem]"
      caption="Installed system"
      lines={[
        { in: 'kiln profile list' },
        { in: 'kiln plan developer' },
        { out: '# what apply would do; changes nothing' },
        { in: 'sudo kiln apply developer' },
        { in: 'sudo kiln remove developer --purge' },
      ]}
    />
    <p class="mt-6">
      Search every package on <a href="https://archlinux.org/packages/" class="link">archlinux.org</a> or with
      <code>pacman -Ss</code>. <a href={`${DOCS}/package-management/`} class="link">Package management docs</a>
    </p>
  </Section>

  {profiles.map((p) => (
    <Section title={p.name} id={p.name} lead={p.description}>
      <ul class="flex flex-wrap gap-x-6 gap-y-1 font-mono">
        {p.packages.map((name) => <li><a href={archPackage(name)} class="link">{name}</a></li>)}
      </ul>
    </Section>
  ))}
</Base>
