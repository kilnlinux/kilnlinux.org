---
import { DOCS, SEARCH } from '../data/site';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { commands, kilnVersion, missing, profiles, repo } from '../data/kiln';

// Recent commits, fetched when the site builds. If GitHub is unreachable the column links to the history instead.
// shortcut: refreshes only on rebuild, so redeploy (or add a scheduled build) to keep it current.
type Commit = { sha: string; commit: { message: string } };
let commits: Commit[] = [];
try {
  const res = await fetch('https://api.github.com/repos/kilnlinux/Kiln-Linux/commits?per_page=10', {
    headers: { Accept: 'application/vnd.github+json' },
  });
  if (res.ok) commits = await res.json();
} catch {}

const gh = (path: string) => `${repo}/tree/main/${path}`;
---
<Base>
  <section class="wrap grid gap-x-8 pt-8 md:grid-cols-12" aria-labelledby="title">
    <div class="flex justify-center py-4 text-accent md:col-span-3 md:py-2">
      <Logo size={140} class="h-auto w-24 md:w-[140px]" />
    </div>
    <div class="space-y-3 md:col-span-9">
      <h1 id="title" class="text-4xl">The Kiln Linux distribution</h1>
      <p>
        Kiln is a minimal distribution based on <a href="https://archlinux.org">Arch Linux</a>. It uses Arch’s
        repositories, pacman and systemd unchanged, and adds a small live ISO with a terminal installer, an optional
        Sway desktop, and <code>kiln</code>, a tool that keeps your package sets in readable
        <a href={SEARCH}>profile</a> files.
      </p>
      <p>
        An installed Kiln system is an Arch system: run <code>pacman -Syu</code> to update it, and the
        <a href="https://wiki.archlinux.org/">Arch wiki</a> applies as is.
      </p>
      <p>
        Kiln runs on x86_64. <a href="/download/">Download the ISO</a>, or
        <a href={`${DOCS}/development/`}>build it yourself</a> with archiso. The source is on <a href={repo}>GitHub</a>; follow the
        <a href={`${repo}/commits/main`}>commit history</a> to see what changed.
      </p>
      <p>
        Read the <a href={`${DOCS}/`}>documentation</a> to learn how Kiln fits together, or start with the
        <a href={`${DOCS}/contributing/`}>contributing guide</a>.
      </p>
    </div>
  </section>

  <hr class="wrap mt-8 border-rule" />

  <section class="wrap grid gap-x-8 gap-y-8 pt-8 sm:grid-cols-2 lg:grid-cols-3 [&_p+p]:mt-3 [&_h2+p]:mt-2" aria-label="Features">
    <div>
      <h2 class="text-2xl">Arch underneath</h2>
      <p>Kiln replaces nothing in Arch. Packages come from the official Arch repositories through pacman.</p>
      <p>
        A pacman hook keeps Kiln’s <code>os-release</code> in place when Arch’s <code>filesystem</code> package
        upgrades. Everything else is a default you can change.
      </p>
    </div>
    <div>
      <h2 class="text-2xl">Live ISO</h2>
      <p>
        The ISO is built with <a href="https://gitlab.archlinux.org/archlinux/archiso">archiso</a> from a profile
        derived from Arch’s <code>releng</code>, cut to about 50 packages. It boots on UEFI and BIOS.
      </p>
      <p><code>make iso</code> builds it without root, in a user namespace.</p>
    </div>
    <div>
      <h2 class="text-2xl">Installer</h2>
      <p>
        <code>kiln-install</code> is a bash script that asks every question first and changes nothing until you
        confirm. Erasing a disk needs its name typed back.
      </p>
      <p>
        It installs with <code>pacstrap</code>, boots with systemd-boot, GRUB or Limine on UEFI or BIOS, and checks the result before it
        reports success.
      </p>
    </div>
    <div>
      <h2 class="text-2xl">Profiles</h2>
      <p>
        A profile is a named list of packages in a TOML file. Kiln ships four: {profiles.map((p, i) => <>{i > 0 && ', '}<code>{p.name}</code></>)}.
        They stack, and you can write your own.
      </p>
      <p><a href={SEARCH}>See what each profile installs</a>.</p>
    </div>
    <div>
      <h2 class="text-2xl">kiln</h2>
      <p>
        <a href={gh('packages/kiln')}>kiln</a> {kilnVersion}, written in Rust, compares a profile with the system and
        has pacman install what’s missing. pacman stays the only package database.
      </p>
      <p>
        <code>kiln remove --purge</code> only uninstalls what kiln itself installed, never a package you added. See
        <a href={`${DOCS}/package-management/`}>package management</a>.
      </p>
    </div>
    <div>
      <h2 class="text-2xl">Sway desktop</h2>
      <p>The optional desktop profile is Sway on Wayland, with foot, fuzzel and mako, and PipeWire for audio.</p>
      <p>There’s no display manager: log in on a TTY and run <code>sway</code>.</p>
    </div>
  </section>

  <hr class="wrap mt-10 border-rule" />

  <section class="wrap grid gap-x-8 gap-y-10 pt-8 lg:grid-cols-3" aria-label="Activity">
    <div>
      <h2 class="flex items-center gap-2 text-2xl">
        Recent commits
        <a href={`${repo}/commits/main.atom`} class="inline-flex rounded-sm bg-accent p-1 text-white hover:bg-heading hover:text-white" aria-label="Commits feed (Atom)">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><circle cx="3" cy="13" r="2" /><path d="M1 6.5v2.2A6.3 6.3 0 0 1 7.3 15h2.2A8.5 8.5 0 0 0 1 6.5Zm0-4.5v2.2A10.8 10.8 0 0 1 11.8 15H14A13 13 0 0 0 1 2Z" /></svg>
        </a>
      </h2>
      {commits.length > 0 ? (
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm marker:text-mute">
          {commits.map((c) => <li><a href={`${repo}/commit/${c.sha}`}>{c.commit.message.split('\n')[0]}</a></li>)}
        </ul>
      ) : (
        <p class="mt-3 text-sm">See the <a href={`${repo}/commits/main`}>commit history on GitHub</a>.</p>
      )}
    </div>
    <div>
      <h2 class="text-2xl">Profiles</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm marker:text-mute">
        {profiles.map((p) => <li><a href={`${SEARCH}#${p.name}`}>{p.name}</a> <span class="text-mute">{p.description}</span></li>)}
      </ul>
      <p class="mt-3 text-sm">Not done yet: {missing.join(', ')}.</p>
    </div>
    <div>
      <h2 class="text-2xl">kiln commands</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm marker:text-mute">
        {commands.map((c) => <li><code>kiln {c.name}</code> <span class="text-mute">{c.help.toLowerCase()}</span></li>)}
      </ul>
    </div>
  </section>
</Base>
