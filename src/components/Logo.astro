---
// The Kiln triangle mark (branding/mark-triangle*.svg), drawn in currentColor.
// The stripes are cut into the path itself: some mobile browsers drop inline SVG masks and show a plain triangle.
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
---
<svg viewBox="8 8 112 108" width={size} height={size * 108 / 112} class={cls} aria-hidden="true">
  <path fill="currentColor" d="M64 8 L84.98 48.46 L36.79 60.48 Z M89.24 56.68 L97.28 72.19 L20.83 91.25 L31.27 71.13 Z M101.54 80.4 L120 116 L8 116 L15.31 101.91 Z" />
</svg>
